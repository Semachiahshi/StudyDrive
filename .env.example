# StudyDrive environment variables — names only. Never commit real values.
# Copy to .env.local for local development; set the same names in Vercel.

# Supabase project (public, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Who may sign in (server-side only). Comma-separated email addresses.
# Nobody can sign in while this is empty.
OWNER_EMAILS=

# Server-side only — used by the reminder cron job. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Email reminders (Resend, https://resend.com)
RESEND_API_KEY=
# e.g. "StudyDrive <pripominky@your-domain.cz>" — the domain must be verified in Resend.
REMINDER_FROM_EMAIL=

# Protects /api/cron/reminders. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Public base URL used in reminder emails (optional on Vercel production).
APP_URL=
